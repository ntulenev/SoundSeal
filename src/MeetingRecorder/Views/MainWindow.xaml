<Window x:Class="MeetingRecorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Display.Title}" Language="en-US" Width="800" Height="640"
        MinWidth="690" MinHeight="600" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="#F5F7F5" Foreground="#172B28" FontFamily="Segoe UI"
        Loaded="OnLoadedAsync" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" GlassFrameThickness="0" ResizeBorderThickness="5" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#213D36"/>
            <Setter Property="BorderBrush" Value="#BFCFC8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#278773"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#126B57"/>
        </Style>
        <Style x:Key="SourceBox" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#D4DDD8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDCCC5"/><Setter Property="ContextMenu" Value="{x:Null}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="RecorderSurface">
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
            <Border BorderBrush="#D0DBD5" BorderThickness="0,0,0,1" Background="#FFFFFF">
                <DockPanel Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="─" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize" BorderThickness="0"/>
                        <Button Content="✕" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close" BorderThickness="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="27" Height="27" Background="#126B57" CornerRadius="7">
                            <Path Stroke="#C2FAE2" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 1,8 L 1,13 M 5,4 L 5,17 M 9,0 L 9,21 M 13,6 L 13,15 M 17,8 L 17,13"/>
                        </Border>
                        <TextBlock Margin="9,0" VerticalAlignment="Center" Text="SoundSeal" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="24,16,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#173B34" CornerRadius="9" Padding="20,11">
                    <Grid>
                        <StackPanel>
                            <TextBlock Foreground="#B7D4CA" Text="Elapsed time" FontSize="13"/>
                            <TextBlock Text="{Binding Display.Elapsed}" FontFamily="Consolas" FontSize="42" Foreground="#F1FFF9" FontWeight="Bold" AutomationProperties.Name="Elapsed time"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding Display.StatusColor}" Margin="0,0,7,0"/>
                            <TextBlock Foreground="White" Text="{Binding Display.Status}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,13,0,8">
                    <Button DockPanel.Dock="Right" Content="Refresh devices" FontSize="12" Padding="9,4" IsEnabled="{Binding CanEdit}" Click="OnRefreshAsync"/>
                    <TextBlock Text="Audio sources" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SourceBox}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Microphone" FontSize="16" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="1" Margin="0,9,0,10" Padding="6,3" MinHeight="30"
                                      ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone}"
                                      ToolTip="{Binding Microphone.Name}" IsEnabled="{Binding CanEdit}"
                                      AutomationProperties.Name="Microphone device">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" MaxWidth="380" TextWrapping="Wrap"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ProgressBar Grid.Row="2" Height="6" Maximum="1" Value="{Binding Display.MicrophoneLevel, Mode=OneWay}"
                                         BorderThickness="0" Background="#DFE8E4" Foreground="#19826A" AutomationProperties.Name="Microphone level"/>
                            <TextBlock Grid.Row="3" Margin="0,4,0,0" FontSize="12" Foreground="#48625B" Text="{Binding Display.MicrophoneSignal}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SourceBox}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Computer audio" FontSize="16" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="1" Margin="0,9,0,10" Padding="6,3" MinHeight="30"
                                      ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}"
                                      ToolTip="{Binding Output.Name}" IsEnabled="{Binding CanEdit}"
                                      AutomationProperties.Name="Computer audio device">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" MaxWidth="380" TextWrapping="Wrap"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ProgressBar Grid.Row="2" Height="6" Maximum="1" Value="{Binding Display.ComputerLevel, Mode=OneWay}"
                                         BorderThickness="0" Background="#DFE8E4" Foreground="#19826A" AutomationProperties.Name="Computer audio level"/>
                            <TextBlock Grid.Row="3" Margin="0,4,0,0" FontSize="12" Foreground="#48625B" Text="{Binding Display.ComputerSignal}"/>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="Recording folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel IsEnabled="{Binding CanEdit}">
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseAsync" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recording folder"/>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,7" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding Display.Detail}" TextWrapping="Wrap" Foreground="#804317" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding Display.File}" TextWrapping="Wrap" Foreground="#23634F" ToolTip="{Binding Display.File}"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="5" BorderBrush="#D0DBD5" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <DockPanel>
                        <Button Content="Open folder" DockPanel.Dock="Right" Click="OnOpen">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                                <DataTrigger Binding="{Binding Display.File}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start recording" Style="{StaticResource Primary}" Click="OnStartAsync" IsEnabled="{Binding CanStart}"/>
                            <Button Content="{Binding Display.PauseLabel}" Margin="8,0" Click="OnPauseAsync" IsEnabled="{Binding Display.CanFinish}"/>
                            <Button Content="Finish recording" Click="OnFinishAsync" IsEnabled="{Binding Display.CanFinish}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="Overlay" Visibility="Collapsed" Background="#A51B302B" Padding="28"
                KeyboardNavigation.TabNavigation="Cycle" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Background="#F9FCFA" CornerRadius="10" Padding="22" MaxWidth="580" VerticalAlignment="Center">
                <Grid>
                    <StackPanel x:Name="FolderPanel" Visibility="Collapsed">
                        <TextBlock Text="Choose recording folder" FontWeight="SemiBold" FontSize="21" Margin="0,0,0,12"/>
                        <DockPanel>
                            <Button Content="Go" DockPanel.Dock="Right" Click="OnGoAsync" Margin="6,0,0,0"/>
                            <Button Content="Up" DockPanel.Dock="Left" Click="OnUpAsync" Margin="0,0,6,0"/>
                            <TextBox x:Name="BrowserPath" AutomationProperties.Name="Folder path" KeyDown="OnPathKeyAsync"/>
                        </DockPanel>
                        <ListBox x:Name="Folders" Height="165" Margin="0,10,0,4" AutomationProperties.Name="Subfolders"
                                 MouseDoubleClick="OnEnterFolderAsync" KeyDown="OnFolderKeyAsync"/>
                        <TextBlock x:Name="FolderNotice" TextWrapping="Wrap" Foreground="#804317"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Cancel" Click="OnCancel" Margin="0,0,6,0"/>
                            <Button Content="Select folder" Click="OnChoose" Style="{StaticResource Primary}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ExitPanel" Visibility="Collapsed">
                        <TextBlock Text="Finish this recording and exit?" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="SoundSeal will save the audio captured so far." Margin="0,8,0,18"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReturnButton" Content="Return to recorder" Click="OnCancel" Margin="0,0,6,0"/>
                            <Button Content="Finish and exit" Click="OnExitAsync" Style="{StaticResource Primary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
