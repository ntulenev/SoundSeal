<Window x:Class="MeetingRecorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:MeetingRecorder.Domain;assembly=MeetingRecorder.Domain"
        Title="{Binding Display.Title}" Icon="/SoundSeal;component/Assets/SoundSeal.ico" ThemeMode="Dark" Language="en-US" Width="800" Height="730"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Bright}" FontFamily="Segoe UI"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="108" GlassFrameThickness="0" ResizeBorderThickness="5" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="MinWidth" Value="690"/>
            <Setter Property="MinHeight" Value="660"/>
        </Style>
    </Window.Style>
    <Window.Resources>
        <ResourceDictionary Source="/SoundSeal;component/Themes/RecorderTheme.xaml"/>
    </Window.Resources>
    <Grid Background="{StaticResource Canvas}">
        <Grid x:Name="RecorderSurface">
            <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Background="{StaticResource Canvas}">
                <DockPanel Margin="18,0,16,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="CompactButton" Content="Compact view" Margin="0,0,14,0" Height="34"
                                Click="OnCompactView" Visibility="{Binding Display.CanFinish, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Keep recording controls above other windows"/>
                        <Button Content="─" Width="40" Height="34" Padding="0" Margin="0,0,10,0"
                                Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                        <Button Content="✕" Width="40" Height="34" Padding="0"
                                Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="105.6" Height="105.6"
                               SnapsToDevicePixels="True" UseLayoutRounding="True"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="/SoundSeal;component/Assets/SoundSeal.png"/>
                                    <Setter Property="AutomationProperties.Name" Value="SoundSeal seal wearing dark sunglasses and headphones"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Display.State}" Value="{x:Static domain:RecorderState.Recording}">
                                            <Setter Property="Source" Value="/SoundSeal;component/Assets/SoundSeal-Recording.png"/>
                                            <Setter Property="AutomationProperties.Name" Value="SoundSeal seal with glowing glasses, recording"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <StackPanel Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="SoundSeal" FontSize="28" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionLabel" Margin="0,2,0,0" FontSize="14" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="24,16,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0" Background="{StaticResource Panel}" CornerRadius="4" Padding="20,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Muted}" Text="Elapsed time" FontSize="13"/>
                            <TextBlock Text="{Binding Display.Elapsed}" FontFamily="Consolas" FontSize="46" Foreground="{StaticResource Bright}" FontWeight="Bold" AutomationProperties.Name="Elapsed time"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding Display.StatusColor}" Margin="0,0,7,0"/>
                            <TextBlock Foreground="{StaticResource Bright}" Text="{Binding Display.Status}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,12,0,8">
                    <Button DockPanel.Dock="Right" Content="Refresh devices" FontSize="12" Padding="9,4" IsEnabled="{Binding CanEdit}" Click="OnRefresh"/>
                    <Button DockPanel.Dock="Right" Content="Check sound" FontSize="12" Padding="9,4" Margin="0,0,6,0"
                            IsEnabled="{Binding CanCheckSound}" Click="OnCheckSound"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Recording mode" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ModeSelector" Margin="12,0,0,0" MinWidth="150" Padding="6,3"
                                  SelectedValuePath="Tag" SelectedValue="{Binding Mode, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Recording mode">
                            <ComboBoxItem Content="Meeting" Tag="{x:Static domain:RecordingMode.Meeting}"/>
                            <ComboBoxItem Content="Computer audio" Tag="{x:Static domain:RecordingMode.Audio}"/>
                            <ComboBoxItem Content="Dictaphone" Tag="{x:Static domain:RecordingMode.Dictaphone}"/>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SourceBox}" IsEnabled="{Binding UsesMicrophone}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Microphone" FontSize="16" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="1" Margin="0,9,0,10" Padding="6,3" MinHeight="30"
                                      ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone}"
                                      ToolTip="{Binding Microphone.Name}" IsEnabled="{Binding CanEdit}"
                                      AutomationProperties.Name="Microphone device">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" MaxWidth="380" TextWrapping="Wrap"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ProgressBar Grid.Row="2" Height="6" Maximum="1" Value="{Binding Display.MicrophoneLevel, Mode=OneWay}"
                                         BorderThickness="0" Background="{StaticResource Rule}" Foreground="{StaticResource Accent}" AutomationProperties.Name="Microphone level"/>
                            <TextBlock Grid.Row="3" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Display.MicrophoneSignal}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsesMicrophone}" Value="False"><Setter Property="Text" Value="Off"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SourceBox}" IsEnabled="{Binding UsesOutput}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Computer audio" FontSize="16" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="1" Margin="0,9,0,10" Padding="6,3" MinHeight="30"
                                      ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}"
                                      ToolTip="{Binding Output.Name}" IsEnabled="{Binding CanEdit}"
                                      AutomationProperties.Name="Computer audio device">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" MaxWidth="380" TextWrapping="Wrap"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ProgressBar Grid.Row="2" Height="6" Maximum="1" Value="{Binding Display.ComputerLevel, Mode=OneWay}"
                                         BorderThickness="0" Background="{StaticResource Rule}" Foreground="{StaticResource Accent}" AutomationProperties.Name="Computer audio level"/>
                            <TextBlock Grid.Row="3" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Display.ComputerSignal}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsesOutput}" Value="False"><Setter Property="Text" Value="Off"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <DockPanel Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Right" Foreground="{StaticResource Bright}" Content="Save in 15-minute parts"
                                  IsChecked="{Binding SplitRecording}" IsEnabled="{Binding CanEdit}"
                                  ToolTip="Publish each 15 minutes of recorded audio to the recording folder"/>
                        <TextBlock Text="Recording folder" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel IsEnabled="{Binding CanEdit}">
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowse" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recording folder"/>
                    </DockPanel>
                </StackPanel>
                <Grid Grid.Row="4" Margin="0,6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Display.Detail}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" AutomationProperties.LiveSetting="Polite"/>
                    <ScrollViewer x:Name="SingleResult" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Display.ShowSingleFile, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel LastChildFill="True" VerticalAlignment="Top">
                            <Button DockPanel.Dock="Right" Content="Copy link" Padding="9,4" Margin="8,0,0,0"
                                    Visibility="{Binding Display.CanCopyLink, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Copy the file link to the clipboard" Click="OnCopyLink"/>
                            <DockPanel x:Name="SingleFileHandle" IsEnabled="{Binding Display.CanCopyLink}" Background="Transparent"
                                       MouseLeftButtonDown="OnFileDragDown" MouseMove="OnFileDragMove" MouseLeftButtonUp="OnFileDragUp">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel"><Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="True"><Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="ToolTip" Value="Drag the WAV to a folder or upload area"/>
                                        </Trigger>
                                    </Style.Triggers></Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Right" Text="Drag WAV" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding Display.CanCopyLink, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding Display.File.Value}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource Accent}"/>
                            </DockPanel>
                        </DockPanel>
                    </ScrollViewer>
                    <DockPanel Grid.Row="1" Visibility="{Binding Display.ShowParts, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Border x:Name="AllPartsHandle" DockPanel.Dock="Right" Cursor="Hand" Padding="8,2"
                                    BorderThickness="1" CornerRadius="4" BorderBrush="{StaticResource Rule}" Background="{StaticResource Panel}"
                                    MouseLeftButtonDown="OnFileDragDown" MouseMove="OnFileDragMove" MouseLeftButtonUp="OnFileDragUp"
                                    ToolTip="Drag every saved WAV in part-number order">
                                <TextBlock Text="Drag all parts" Foreground="{StaticResource Accent}"/>
                            </Border>
                            <TextBlock Text="{Binding Display.Files.Count, StringFormat='Saved files ({0})'}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="SavedParts" ItemsSource="{Binding Display.Files}" HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Saved recording files">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Value}" Margin="4,1">
                                        <Button DockPanel.Dock="Right" Content="Copy link" Click="OnCopyLink" Padding="8,3"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                                   Cursor="Hand" Background="Transparent" ToolTip="Drag this WAV file"
                                                   MouseLeftButtonDown="OnFileDragDown" MouseMove="OnFileDragMove" MouseLeftButtonUp="OnFileDragUp"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="{Binding FileActionStatus}" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
                <Border Grid.Row="5" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <DockPanel>
                        <Button Content="Open folder" DockPanel.Dock="Right" Click="OnOpen">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                                <DataTrigger Binding="{Binding Display.File}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start recording" Style="{StaticResource Primary}" Click="OnStart" IsEnabled="{Binding CanStart}"/>
                            <Button Content="{Binding Display.PauseLabel}" Margin="8,0" Click="OnPause" IsEnabled="{Binding Display.CanFinish}"/>
                            <Button Content="Finish recording" Click="OnFinish" IsEnabled="{Binding Display.CanFinish}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="CompactSurface" Width="344" Height="104" Visibility="Collapsed" Background="{StaticResource Canvas}"
                BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7,12,9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Display.Elapsed}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"
                           VerticalAlignment="Center" AutomationProperties.Name="Elapsed time"/>
                <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,5,0">
                    <Ellipse Width="7" Height="7" Fill="{Binding Display.StatusColor}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Display.Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display.Status}"
                               FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
                <Button x:Name="FullViewButton" Grid.Column="2" Content="Full view" VerticalAlignment="Center" Padding="8,4"
                        Click="OnFullView" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Return to the full recorder"/>
                <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Columns="3" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="Start" IsEnabled="{Binding Display.CanResume}" Click="OnPause" Margin="0,0,4,0"
                            ToolTip="Resume this recording"/>
                    <Button Content="Stop" IsEnabled="{Binding Display.CanPause}" Click="OnPause" Margin="4,0"
                            ToolTip="Pause this recording"/>
                    <Button Content="Finish" IsEnabled="{Binding Display.CanFinish}" Click="OnFinish" Margin="4,0,0,0"
                            Style="{StaticResource Primary}" ToolTip="Save the recording and return to full view"/>
                </UniformGrid>
            </Grid>
        </Border>
        <Border x:Name="Overlay" Visibility="Collapsed" Background="{StaticResource Shade}" Padding="28"
                KeyboardNavigation.TabNavigation="Cycle" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="22" MaxWidth="580" VerticalAlignment="Center">
                <Grid>
                    <StackPanel x:Name="FolderPanel" Visibility="Collapsed">
                        <TextBlock Text="Choose recording folder" FontWeight="SemiBold" FontSize="21" Margin="0,0,0,12"/>
                        <DockPanel>
                            <Button Content="Go" DockPanel.Dock="Right" Click="OnGo" Margin="6,0,0,0"/>
                            <Button Content="Up" DockPanel.Dock="Left" Click="OnUp" Margin="0,0,6,0"/>
                            <TextBox x:Name="BrowserPath" Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Folder path" KeyDown="OnPathKey"/>
                        </DockPanel>
                        <ListBox x:Name="Folders" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedName}" Height="165" Margin="0,10,0,4" AutomationProperties.Name="Subfolders"
                                 MouseDoubleClick="OnEnterFolder" KeyDown="OnFolderKey"/>
                        <TextBlock x:Name="FolderNotice" Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource Warning}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Cancel" Click="OnCancel" Margin="0,0,6,0"/>
                            <Button Content="Select folder" Click="OnChoose" Style="{StaticResource Primary}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ExitPanel" Visibility="Collapsed">
                        <TextBlock Text="Finish this recording and exit?" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="SoundSeal will save the audio captured so far." Margin="0,8,0,18"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReturnButton" Content="Return to recorder" Click="OnCancel" Margin="0,0,6,0"/>
                            <Button Content="Finish and exit" Click="OnExit" Style="{StaticResource Primary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
