<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;CA1303;CA1515</NoWarn>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SoundSeal</AssemblyName>
    <Product>SoundSeal</Product>
    <Version>1.1.6</Version>
    <ApplicationIcon>Assets\SoundSeal.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeetingRecorder.Domain\MeetingRecorder.Domain.csproj" />
    <ProjectReference Include="..\MeetingRecorder.Application\MeetingRecorder.Application.csproj" />
    <ProjectReference Include="..\MeetingRecorder.Infrastructure\MeetingRecorder.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\SoundSeal.png" />
    <Resource Include="Assets\SoundSeal.ico" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>
</Project>
